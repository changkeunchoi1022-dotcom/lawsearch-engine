# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model ID for server-side structured extraction and Q&A.
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LAW_GO_KR_OC: 국가법령정보센터(open.law.go.kr) Open API 인증키 (OC 파라미터: 이메일 ID 등)
# 미설정 시 '실시간 법령 연결 미설정' 상태로 표시되며 수동 원문 업로드 및 데모 워크스페이스만 사용 가능합니다.
LAW_GO_KR_OC=""

# LAWNB_ENABLED: 로앤비(LAWnB) 공식 라이선스 연동 허용 여부 (기본값 false, 계약 및 이용약관 승인 전 비활성화)
LAWNB_ENABLED="false"
LAWNB_API_KEY=""
LAWNB_ENDPOINT=""

# ALLOW_EXTERNAL_AI_CONTRACT_PROCESSING: 업로드된 계약서/현장 문서를 외부 AI(Gemini)로 전송하여 사실 추출하는 것을 조직 정책상 허용하는지 여부 ("true" | "false")
ALLOW_EXTERNAL_AI_CONTRACT_PROCESSING="false"

# AUTH_MODE: 인증 연동 모드 ("SSO_HEADER_OR_SESSION" | "STRICT_OIDC")
AUTH_MODE="SSO_HEADER_OR_SESSION"
OIDC_ISSUER_URL=""
OIDC_AUDIENCE=""

# SQLITE_DB_PATH: 서버 영구 저장소 SQLite 데이터베이스 파일 경로
SQLITE_DB_PATH="./data/public_construction_legal_review.sqlite"

# AMENDMENT_SCHEDULER_ENABLED: 개정 모니터링 스케줄러 설정 여부 ("true" | "false")
AMENDMENT_SCHEDULER_ENABLED="false"
AMENDMENT_SCHEDULER_CRON=""
